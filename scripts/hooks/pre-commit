#!/usr/bin/env bash
# Pre-commit hook: lint staged workflows and markdown when the tooling is
# present.
#
# Defensive: each linter no-ops cleanly when not installed, so the hook never
# blocks a commit on a machine without the toolchain.
#
# Activated per clone via: git config core.hooksPath scripts/hooks
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if echo "$staged" | grep -qE '^\.github/workflows/.*\.ya?ml$'; then
  if command -v actionlint >/dev/null 2>&1; then
    actionlint
  else
    echo "pre-commit: actionlint not installed; skipping workflow lint"
  fi
fi

if echo "$staged" | grep -qE '\.md$'; then
  if command -v markdownlint-cli2 >/dev/null 2>&1; then
    echo "$staged" | grep -E '\.md$' | tr '\n' '\0' | xargs -0 markdownlint-cli2
  else
    echo "pre-commit: markdownlint-cli2 not installed; skipping markdown lint"
  fi
fi
